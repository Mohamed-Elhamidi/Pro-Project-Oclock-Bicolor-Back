{% extends 'base.html.twig' %}

{% block title %}User{% endblock %}

{% block body %}
    <h1 class="mx-2 mt-2">User {{user.id}}</h1>
    <div class="container mt-5">
    <table class="table">
        <tbody>
            <tr>
                <th>Id</th>
                <td>{{ user.id }}</td>
            </tr>
              <tr>
                <th>Name</th>
                <td>{{ user.name }}</td>
            </tr>
            <tr>
                <th>Email</th>
                <td>{{ user.email }}</td>
            </tr>
            <tr>
                <th>Roles</th>
                <td>{{ user.roles ? user.roles|json_encode : '' }}</td>
            </tr>
        </tbody>
    </table>

    <a href="{{ path('app_admin_user_list') }}"class="btn btn-dark mt-3">Back to list</a>

    <a href="{{ path('app_admin_user_edit', {'id': user.id}) }}" class="btn btn-success mt-3">Edit</a>

   {{ include('back/user/_delete_form.html.twig') }}
   </div>
{% endblock %}
