{% extends 'base.html.twig' %}

{% block title %}User{% endblock %}

{% block body %}
    <h1 class="mx-2 mt-2">User {{user.id}}</h1>
    <div class="container mt-5">
    <table class="table">
        <tbody>
            <tr>
                <th>Id</th>
                <th>Name</th>
                <th>Email</th>
                <th>Roles</th>
                <th>Scores</th>
                
            </tr>
            <tr>
                <td>{{ user.id }}</td>
                <td>{{ user.name }}</td>
                <td>{{ user.email }}</td>
                <td>{{ user.roles ? user.roles|json_encode : '' }}</td>
                <td>
                    {% if user.scores|length > 0 %}
                    {% for scores in user.scores %}
                       
                       <div> {{scores.idgame.name}} = {{scores.nbPoints}} points<br></div>
                        
                    {% endfor %}
                {% else %}
                    No scores available
                {% endif %}
                </td>
        </tbody>
    </table>

    <a href="{{ path('app_admin_user_list') }}"class="btn btn-dark mt-3">Back to list</a>

    <a href="{{ path('app_admin_user_edit', {'id': user.id}) }}" class="btn btn-success mt-3">Edit</a>

   {{ include('back/user/_delete_form.html.twig') }}
   </div>
{% endblock %}
