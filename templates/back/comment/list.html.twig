{% extends 'base.html.twig' %}

{% block title %}Listes des commentaires{% endblock %}
{% block commentActive %}active{% endblock %}

{% block body %}
    <div class="container mt-5">
        <h1 class="mb-4">Liste des commentaires</h1>
<a href="{{ path('app_admin_comment_add')}}" class="btn btn-primary mt-3 mb-3">Créer un commentaire</a>
     <div class="table-responsive">
            <table class="table table-striped">
                <thead>
                    <tr>
                        <th scope="col">Id</th>
                        <th scope="col">Contenu</th>
                        <th scope="col">Date</th>
                        <th scope="col">Options</th>
                        
                    </tr>
        </thead>
        <tbody>
        {% for comment in comments %}
    
            <tr>
                <td>{{ comment.id }}</td>
                <td>{{ comment.content }}</td>
                <td>{{ comment.createdAt|date('d-m-Y H:i:s') }}</td>
                <td>
                    <a href="{{ path('app_admin_comment_show', {'id': comment.id}) }}"class="btn btn-sm btn-primary">Voir</a>
                   <a href="{{ path('app_admin_comment_edit', {'id': comment.id}) }}" class="btn btn-sm btn-success" onclick="return confirm('Êtes-vous sûr de vouloir modifier ce commentaire ?')">Modifier</a>
                    {{ include('back/comment/_delete_form.html.twig') }}
                </td>
            </tr>
        {% else %}
            <tr>
                <td colspan="5">Pas de commentaires trouvés</td>
            </tr>
        {% endfor %}
        </tbody>
    </table>

    
{% endblock %}
